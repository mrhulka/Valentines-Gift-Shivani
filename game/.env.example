# --- Core (optional) ---
PORT=3000

# Round timing (ms) — tune the game feel. Defaults shown.
ANSWER_MS=10000   # answering window per question
CLIP_MS=7000      # how long the mystery clip plays
REVEAL_MS=6000    # reveal/leaderboard dwell before next question

# --- Spotify (OPTIONAL personalization layer) ---
# Leave blank to run the game with zero Spotify setup (uses the curated songs.json).
# Metadata only — no audio is ever fetched, downloaded, or proxied from Spotify.
# Create an app at https://developer.spotify.com/dashboard, add the redirect URI below.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# --- YouTube ---
# Playback is the YouTube IFrame player. To turn Spotify tracks into playable
# videos the server searches the YouTube DATA API (videoEmbeddable=true), so a
# key is REQUIRED for Spotify-sourced songs to play. Get one at
# https://console.cloud.google.com → enable "YouTube Data API v3" → create an API key.
# (Default quota ~10k units/day ≈ 100 searches/day; results are cached.)
YOUTUBE_API_KEY=
